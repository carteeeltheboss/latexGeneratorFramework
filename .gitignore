# =============================================================================
# Agentic Presentation Builder
# Python / Flask / LaTeX / Docker / cross-platform development
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and machine-local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.secret
*.secrets
secrets/
.direnv/
.envrc
instance/

# User-generated project configurations (keep examples/templates)
/project.yaml
/project.yml
/projects/
!project.example.yaml
!project.example.yml
!projects/.gitkeep

# -----------------------------------------------------------------------------
# Python virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Python bytecode, caches and build artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Package-manager and installer logs
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Tests, coverage, linters and type-checkers
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pyright/
.ruff_cache/
.cache/

# -----------------------------------------------------------------------------
# Flask / WSGI runtime files
# -----------------------------------------------------------------------------
flask_session/
sessions/
*.pid
*.pid.lock
*.sock

# -----------------------------------------------------------------------------
# Generated application files and user uploads
# -----------------------------------------------------------------------------
/exports/
/output/
/outputs/
/generated/
/uploads/
/user_uploads/
/tmp/
/temp/
*.zip
*.tar
*.tar.gz
*.tgz

# Allow intentionally versioned archive fixtures under resources or tests
!resources/**/*.zip
!tests/fixtures/**/*.zip

# -----------------------------------------------------------------------------
# LaTeX auxiliary and compilation files
# Do not ignore every PDF: PDF files may be legitimate presentation assets.
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.dvi
*.fdb_latexmk
*.fls
*.fmt
*.fot
*.lof
*.log
*.lot
*.nav
*.out
*.ps
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.synctex.gz(busy)
*.toc
*.vrb
*.xdv

# LaTeX indexes, glossaries, nomenclature and minitoc
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.idx
*.ilg
*.ind
*.ist
*.loa
*.maf
*.mtc
*.mtc0
*.mtc1
*.nlo
*.nls
*.slf
*.slo
*.sls
*.thm

# TikZ/externalisation, minted, PythonTeX, SageTeX and SVG conversion
*.tikz
*.pyg
*.pytxcode
*.sage.py
_minted-*/
*.listing
*.w18
*-converted-to.pdf
svg-inkscape/

# Common final PDFs produced by this repository
/main.pdf
/presentation.pdf
/presentation_template.pdf
/resources/main.pdf
/resources/presentation.pdf
/resources/presentation_template.pdf

